---
import type { InferGetStaticPropsType } from 'astro';

import { person } from '@data/site';
import { getProjectListItem } from '@helpers/projects/getProjectListItem';
import { getProjects } from '@helpers/projects/getProjects';
import { getCompanyBadges } from '@helpers/timeline/getCompanyBadges';
import { getDictionary } from '@lib/i18n/getDictionary';
import { getLocalePaths } from '@lib/i18n/getLocalePaths';

import ContactSection from '@organisms/ContactSection/ContactSection.astro';
import FeaturedProjects from '@organisms/FeaturedProjects/FeaturedProjects.astro';
import Hero from '@organisms/Hero/Hero.astro';
import MainTemplate from '@templates/MainTemplate/MainTemplate.astro';

export const getStaticPaths = getLocalePaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { locale } = Astro.props;

const { meta } = getDictionary(locale, { name: person.name, role: person.jobTitle });
const projects = await getProjects(locale);
const featured = await Promise.all(
  projects.filter((project) => project.featured).map((project) => getProjectListItem(project, locale)),
);
---

<MainTemplate locale={locale} title={meta.title} contactCta={false}>
  <Hero locale={locale} companies={await getCompanyBadges(locale)} />

  <FeaturedProjects locale={locale} items={featured} total={projects.length} />

  <ContactSection locale={locale} />
</MainTemplate>

---
import type { InferGetStaticPropsType } from 'astro';
import { getRelativeLocaleUrl } from 'astro:i18n';

import { getLocalizedCollection } from '@helpers/content/getLocalizedCollection';
import { getSkillBadges } from '@helpers/skills/getSkillBadges';
import { getDictionary } from '@lib/i18n/getDictionary';
import { defaultLocale, locales } from '@lib/i18n/languages';

import Text from '@atoms/Text/Text.astro';
import ArrowLink from '@molecules/ArrowLink/ArrowLink.astro';
import ArticleSection from '@molecules/ArticleSection/ArticleSection.astro';
import Screenshot from '@molecules/Screenshot/Screenshot.astro';
import Section from '@molecules/Section/Section.astro';
import ArticleLayout from '@organisms/ArticleLayout/ArticleLayout.astro';
import Gallery from '@organisms/Gallery/Gallery.astro';
import Lightbox from '@organisms/Lightbox/Lightbox.astro';
import ProjectAside from '@organisms/ProjectAside/ProjectAside.astro';
import ProjectStory from '@organisms/ProjectStory/ProjectStory.astro';
import MainTemplate from '@templates/MainTemplate/MainTemplate.astro';

export const getStaticPaths = async () => {
  const paths = await Promise.all(
    locales.map(async (locale) => {
      const projects = await getLocalizedCollection('projects', locale);

      return projects.map((project) => ({
        params: { locale: locale === defaultLocale ? undefined : locale, slug: project.id },
        props: { locale, project, stack: getSkillBadges(project.stack, projects, locale) },
      }));
    }),
  );

  return paths.flat();
};

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { locale, project, stack } = Astro.props;

const { projects, lightbox } = getDictionary(locale);

const [lead, ...gallery] = project.gallery;
const zoom = { group: 'project', label: lightbox.open };
---

<MainTemplate locale={locale} title={project.name} description={project.summary}>
  <ArrowLink href={getRelativeLocaleUrl(locale, 'projects/')} title={projects.back} direction='back'>
    {projects.back}
  </ArrowLink>

  <Section id='project' title={project.name} level={1} gap='lg'>
    <Text size='lg' color='strong'>
      {project.summary}
    </Text>

    <ArticleLayout asideLabel={projects.details}>
      {lead && <Screenshot {...lead} sizes='(max-width: 1024px) 100vw, 860px' priority zoom={zoom} />}

      <ProjectStory project={project} locale={locale} />

      {gallery.length > 0 && (
        <ArticleSection id='gallery' title={projects.gallery}>
          <Gallery images={gallery} zoom={zoom} />
        </ArticleSection>
      )}

      {project.lighthouse && (
        <ArticleSection id='lighthouse' title={projects.lighthouse}>
          <Gallery images={project.lighthouse} zoom={zoom} />
        </ArticleSection>
      )}

      <ProjectAside project={project} stack={stack} locale={locale} slot='aside' />
    </ArticleLayout>
  </Section>

  {lead && <Lightbox locale={locale} />}
</MainTemplate>

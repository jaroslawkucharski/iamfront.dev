---
import type { InferGetStaticPropsType } from 'astro';

import { getLocalizedCollection } from '@helpers/content/getLocalizedCollection';
import { getDictionary } from '@lib/i18n/getDictionary';
import { getLocalePaths } from '@lib/i18n/getLocalePaths';

import Section from '@molecules/Section/Section.astro';
import FilterGroup from '@organisms/FilterGroup/FilterGroup.astro';
import ProjectList from '@organisms/ProjectList/ProjectList.astro';
import MainTemplate from '@templates/MainTemplate/MainTemplate.astro';

export const getStaticPaths = getLocalePaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { locale } = Astro.props;

const projects = await getLocalizedCollection('projects', locale);

const { projects: dictionary, projectCount } = getDictionary(locale);

const skillCounts = Map.groupBy(
  projects.flatMap((project) => project.stack),
  (skill) => skill,
);

const skillOptions = [...skillCounts]
  .map(([skill, items]) => ({ value: skill, label: skill, count: items.length }))
  .sort((first, second) => second.count - first.count || first.label.localeCompare(second.label, locale));

const chips = {
  label: dictionary.skillFilterLabel,
  param: 'skills',
  visible: 8,
  moreLabel: dictionary.showAllSkills,
  lessLabel: dictionary.showFewerSkills,
  searchLabel: dictionary.skillSearchLabel,
  searchPlaceholder: dictionary.skillSearchPlaceholder,
  noMatchText: dictionary.skillSearchEmpty,
  options: skillOptions,
};
---

<MainTemplate locale={locale} title={dictionary.meta.title} description={dictionary.meta.description}>
  <Section id='projects' title={dictionary.heading} level={1}>
    <FilterGroup
      controls='project-list'
      chips={chips}
      clearLabel={dictionary.clear}
      countForms={projectCount}
      shownTemplate={dictionary.shown}
      emptyText={dictionary.empty}
    />

    <ProjectList
      id='project-list'
      projects={projects}
      locale={locale}
      label={dictionary.listLabel}
      labelsLabel={dictionary.labelsLabel}
      techLabel={dictionary.stack}
      level={2}
    />
  </Section>
</MainTemplate>

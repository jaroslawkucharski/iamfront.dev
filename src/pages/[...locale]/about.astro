---
import type { InferGetStaticPropsType } from 'astro';
import { getRelativeLocaleUrl } from 'astro:i18n';

import { person } from '@config/site';
import { getLocalizedCollection } from '@helpers/content/getLocalizedCollection';
import { sortProjects } from '@helpers/projects/sortProjects';
import { getExperienceText } from '@helpers/experience/getExperienceText';
import { getSkillBadges } from '@helpers/skills/getSkillBadges';
import { getDictionary } from '@lib/i18n/getDictionary';
import { getLocalePaths } from '@lib/i18n/getLocalePaths';
import { interpolate } from '@lib/i18n/interpolate';
import type { TimelineEntry } from '@typings/content';

import Section from '@molecules/Section/Section.astro';
import AboutIntro from '@organisms/AboutIntro/AboutIntro.astro';
import GroupedBadgeList from '@organisms/GroupedBadgeList/GroupedBadgeList.astro';
import Timeline from '@organisms/Timeline/Timeline.astro';
import MainTemplate from '@templates/MainTemplate/MainTemplate.astro';

export const getStaticPaths = getLocalePaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { locale } = Astro.props;

const timeline = await getLocalizedCollection('timeline', locale);
const education = timeline.filter(({ kind }) => kind === 'education');
const experience = timeline.filter(({ kind }) => kind === 'experience');
const hobbies = timeline.filter(({ kind }) => kind === 'hobby');
const [profile] = await getLocalizedCollection('profile', locale);
const projects = sortProjects(await getLocalizedCollection('projects', locale));
const skillCategories = await getLocalizedCollection('skillCategories', locale);

const { about } = getDictionary(locale, { name: person.name });

const skillGroups = skillCategories.map((category) => ({
  label: category.label,
  items: getSkillBadges(category.skills, projects, locale),
}));

const toTimeline = (entries: TimelineEntry[]) =>
  entries.map((entry) => ({
    ...entry,
    sections: entry.sections?.map(({ stack, project: projectId, ...section }) => {
      const project = projects.find((item) => item.id === projectId);
      const skills = stack ?? project?.stack;

      return {
        ...section,
        stack: skills && getSkillBadges(skills, projects, locale),
        projectHref: project && getRelativeLocaleUrl(locale, `projects/${project.id}/`),
      };
    }),
  }));
---

<MainTemplate locale={locale} title={about.meta.title} description={about.meta.description}>
  <AboutIntro bio={interpolate(profile.bio, { experience: getExperienceText(locale) })} locale={locale} />

  <Section id='skills' title={about.skills.heading}>
    <GroupedBadgeList groups={skillGroups} />
  </Section>

  <Section id='experience' title={about.experience.heading}>
    <Timeline
      entries={toTimeline(experience)}
      locale={locale}
      stackLabel={about.experience.stackLabel}
      projectLinkLabel={about.experience.projectLinkLabel}
    />
  </Section>

  <Section id='education' title={about.education.heading}>
    <Timeline entries={toTimeline(education)} locale={locale} stackLabel={about.education.detailsLabel} />
  </Section>

  <Section id='hobbies' title={about.hobbies.heading}>
    <Timeline entries={toTimeline(hobbies)} locale={locale} ordered={false} />
  </Section>
</MainTemplate>

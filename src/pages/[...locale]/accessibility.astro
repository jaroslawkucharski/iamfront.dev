---
import type { InferGetStaticPropsType } from 'astro';

import { getTextPage } from '@helpers/textPages/getTextPage';
import { getLocalePaths } from '@lib/i18n/getLocalePaths';

import TextPage from '@templates/TextPage/TextPage.astro';

export const getStaticPaths = getLocalePaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { locale } = Astro.props;
---

<TextPage id='accessibility' locale={locale} content={await getTextPage('accessibility', locale)} />

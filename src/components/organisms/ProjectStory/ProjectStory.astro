---
import type { Project } from '@helpers/projects/getProjects';
import { getDictionary } from '@lib/i18n/getDictionary';
import type { Locale } from '@lib/i18n/languages';

import ArticleSection from '@molecules/ArticleSection/ArticleSection.astro';
import RichText from '@molecules/RichText/RichText.astro';

interface Props {
  project: Project;
  locale: Locale;
}

const { project, locale } = Astro.props;

const { projects, externalLink } = getDictionary(locale);
const newTab = ` ${externalLink.newTab}`;

const parts = (['situation', 'task', 'action', 'result'] as const).map((part) => ({
  id: `story-${part}`,
  title: projects.star[part],
  paragraphs: project.star[part].split(/\n{2,}/),
}));
---

{parts.map((part) => (
  <ArticleSection id={part.id} title={part.title}>
    {part.paragraphs.map((paragraph) => (
      <RichText text={paragraph} newTabLabel={newTab} />
    ))}
  </ArticleSection>
))}

---
import { getDictionary } from '@lib/i18n/getDictionary';
import type { Locale } from '@lib/i18n/languages';
import type { Project } from '@typings/content';

import Text from '@atoms/Text/Text.astro';
import ArticleSection from '@molecules/ArticleSection/ArticleSection.astro';

interface Props {
  project: Project;
  locale: Locale;
}

const { project, locale } = Astro.props;

const { projects } = getDictionary(locale);

const parts = (['situation', 'task', 'action', 'result'] as const).map((part) => ({
  id: `story-${part}`,
  title: projects.star[part],
  text: project.star[part],
}));
---

{parts.map((part) => (
  <ArticleSection id={part.id} title={part.title}>
    <Text as='div' class='project-story__text'>
      <Fragment set:html={part.text} />
    </Text>
  </ArticleSection>
))}

<style>
  :global(.project-story__text p) {
    margin: 0;
  }

  :global(.project-story__text p + p) {
    margin-block-start: var(--space-sm);
  }
</style>

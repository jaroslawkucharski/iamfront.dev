---
import type { BadgeItem } from '@typings/badge';

import DescriptionList from '@atoms/DescriptionList/DescriptionList.astro';
import BadgeList from '@molecules/BadgeList/BadgeList.astro';
import DescriptionItem from '@molecules/DescriptionItem/DescriptionItem.astro';

interface BadgeGroup {
  label: string;
  items: string | readonly (string | BadgeItem)[];
}

interface Props {
  groups: readonly BadgeGroup[];
}

const { groups } = Astro.props;
---

<DescriptionList>
  {groups.map((group) => (
    <DescriptionItem term={group.label}>
      <BadgeList label={group.label} items={group.items} variant='text' />
    </DescriptionItem>
  ))}
</DescriptionList>

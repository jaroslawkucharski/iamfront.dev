---
import Text from '@atoms/Text/Text.astro';
import RichText from '@molecules/RichText/RichText.astro';

export interface DescriptionItem {
  term: string;
  text?: string;
  [key: string]: unknown;
}

interface Props {
  items: readonly DescriptionItem[];
  stacked?: boolean;
  class?: string;
}

const { items, stacked = false, class: className } = Astro.props;

const custom = Astro.slots.has('default');
const rendered = custom ? await Promise.all(items.map((item) => Astro.slots.render('default', [item]))) : [];
---

<dl class:list={['description-list', { 'description-list--stacked': stacked }, className]}>
  {items.map((item, index) => (
    <div class='description-list__row'>
      <Text as='dt' size='md' weight='medium' color='default' tracking='label'>
        {item.term}
      </Text>

      <dd class='description-list__content'>
        {custom ? <Fragment set:html={rendered[index]} /> : item.text && <RichText text={item.text} />}
      </dd>
    </div>
  ))}
</dl>

<style>
  .description-list {
    display: grid;
    gap: var(--space-sm);
    margin: 0;
  }

  .description-list__row {
    display: grid;
    grid-template-columns: var(--label-column) 1fr;
    align-items: baseline;
    gap: var(--space-2xs) var(--space-sm);
  }

  .description-list__content {
    margin: 0;
  }

  .description-list--stacked .description-list__row {
    grid-template-columns: 1fr;
  }

  @media (max-width: 768px) {
    .description-list__row {
      grid-template-columns: 1fr;
    }
  }
</style>

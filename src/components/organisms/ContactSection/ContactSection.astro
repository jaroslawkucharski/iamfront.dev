---
import { getDictionary } from '@lib/i18n/getDictionary';
import type { Locale } from '@lib/i18n/languages';

import Text from '@atoms/Text/Text.astro';
import Section from '@molecules/Section/Section.astro';
import BulletList from '@organisms/BulletList/BulletList.astro';
import ContactForm from '@organisms/ContactForm/ContactForm.astro';
import ContactLinks from '@organisms/ContactLinks/ContactLinks.astro';

interface Props {
  intro: string;
  points: string[];
  locale: Locale;
}

const { intro, points, locale } = Astro.props;

const { contact } = getDictionary(locale);
---

<Section id='contact' title={contact.heading} layout='split'>
  <Text color='default' slot='aside'>
    {intro}
  </Text>

  <BulletList items={points} variant='check' slot='aside' />

  <ContactLinks locale={locale} slot='aside' />

  <ContactForm locale={locale} />
</Section>

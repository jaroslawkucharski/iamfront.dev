---
import type { ImageMetadata } from 'astro';

import type { Locale } from '@lib/i18n/languages';

import Flex from '@atoms/Flex/Flex.astro';
import Icon from '@atoms/Icon/Icon.astro';
import Link from '@atoms/Link/Link.astro';
import Picture from '@atoms/Picture/Picture.astro';
import Text from '@atoms/Text/Text.astro';
import BadgeList from '@molecules/BadgeList/BadgeList.astro';
import DateRange from '@molecules/DateRange/DateRange.astro';

export interface MediaListItem {
  title: string;
  href?: string;
  description: string;
  start?: string;
  end?: string;
  archived?: boolean;
  labels?: readonly string[];
  skills?: readonly string[];
  tech?: readonly string[];
  image?: { src: ImageMetadata; dark?: ImageMetadata; alt: string };
}

type Levels = 2 | 3 | 4;

interface Props {
  items: readonly MediaListItem[];
  locale: Locale;
  label: string;
  labelsLabel?: string;
  techLabel?: string;
  level?: Levels;
  id?: string;
  class?: string;
}

const { items, locale, label, labelsLabel = '', techLabel = '', level = 3, id, class: className } = Astro.props;
---

<ul id={id} class:list={['media-list', className]} aria-label={label}>
  {items.map((project) => (
    <li
      class:list={['media-list__item', { 'media-list__item--archived': project.archived }]}
      data-skills={project.skills ? project.skills.join(' ') : undefined}
    >
      {project.image ? (
        <Picture
          src={project.image.src}
          dark={project.image.dark}
          alt={project.image.alt}
          widths={[200, 400, 800]}
          sizes='(max-width: 768px) 110px, 200px'
          class='media-list__thumb'
          loading='lazy'
          decoding='async'
        />
      ) : (
        <span class='media-list__thumb media-list__thumb--empty' aria-hidden='true'>
          {project.title
            .split(/[\s:]+/)
            .filter((word) => word.length > 1)
            .slice(0, 2)
            .map((word) => word[0].toUpperCase())
            .join('')}
        </span>
      )}

      <Flex gap='2xs' class='media-list__main'>
        <Text as={`h${level}`} size='md' weight='medium' color='default' tracking='label'>
          {project.href ? (
            <Link
              href={project.href}
              title={project.title}
              size='md'
              weight='medium'
              color='default'
              tracking='label'
              wrap
              class='media-list__link'
            >
              {project.title}

              <Icon name='arrow-right' size={16} class='media-list__arrow' />
            </Link>
          ) : (
            project.title
          )}
        </Text>

        <Text size='sm' color='muted' class='media-list__description'>
          {project.description}
        </Text>

        {project.tech && project.tech.length > 0 && (
          <BadgeList
            label={techLabel}
            items={[
              ...project.tech.slice(0, 4).map((name) => ({ label: name, muted: true })),
              ...(project.tech.length > 4 ? [{ label: `+${project.tech.length - 4}`, muted: true }] : []),
            ]}
            variant='text'
            size='sm'
            class='media-list__tech'
          />
        )}
      </Flex>

      {(project.start || (project.labels && project.labels.length > 0)) && (
        <Flex gap='2xs' align='end' class='media-list__aside'>
          {project.start && <DateRange start={project.start} end={project.end} locale={locale} />}

          {project.labels && project.labels.length > 0 && <BadgeList label={labelsLabel} items={project.labels} />}
        </Flex>
      )}
    </li>
  ))}
</ul>

<style>
  .media-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .media-list__item {
    position: relative;
    display: grid;
    grid-template-columns: var(--thumb-width) minmax(0, 1fr) auto;
    grid-template-rows: 1fr auto auto auto 1fr;
    align-items: baseline;
    gap: var(--space-2xs) var(--space-lg);
    padding: var(--space-lg) var(--space-xs);
    border-top: var(--border-width) solid var(--color-border-subtle);
  }

  .media-list__item:last-child {
    border-bottom: var(--border-width) solid var(--color-border-subtle);
  }

  .media-list__item[hidden] {
    display: none;
  }

  .media-list :global(.media-list__description) {
    display: -webkit-box;
    max-width: 60ch;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
  }

  .media-list :global(.media-list__main),
  .media-list :global(.media-list__aside) {
    display: contents;
  }

  .media-list :global(.media-list__main > :first-child) {
    grid-column: 2;
    grid-row: 2;
  }

  .media-list :global(.media-list__description) {
    grid-column: 2;
    grid-row: 3;
  }

  .media-list :global(.media-list__tech) {
    grid-column: 2;
    grid-row: 4;
    margin-top: var(--space-2xs);
  }

  .media-list :global(.media-list__aside > :first-child) {
    grid-column: 3;
    grid-row: 2;
    justify-self: end;
  }

  .media-list :global(.media-list__aside > :nth-child(2)) {
    grid-column: 3;
    grid-row: 3;
    justify-self: end;
    align-self: start;
  }

  .media-list :global(.media-list__thumb) {
    grid-column: 1;
    grid-row: 1 / -1;
    align-self: center;
    display: block;
    width: var(--thumb-width);
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top center;
    border: var(--border-width) solid var(--color-border-subtle);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    transition: opacity var(--duration-fast) var(--ease-standard);
  }

  .media-list__item--archived :global(img.media-list__thumb) {
    filter: grayscale(1);
    opacity: 0.6;
    transition:
      filter var(--duration-fast) var(--ease-standard),
      opacity var(--duration-fast) var(--ease-standard);
  }

  .media-list__item--archived :global(.media-list__link) {
    color: var(--color-text-muted);
  }

  .media-list__item--archived:is(:hover, :focus-within) :global(img.media-list__thumb) {
    filter: none;
    opacity: 1;
  }

  .media-list__item--archived:is(:hover, :focus-within) :global(.media-list__link) {
    color: var(--color-text);
  }

  .media-list :global(.media-list__thumb--empty) {
    display: grid;
    place-items: center;
    color: var(--color-text-muted);
    font-size: var(--fs-lg);
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-wide);
  }

  .media-list__item:has(:global(.media-list__link)):hover :global(.media-list__thumb) {
    opacity: var(--opacity-pressed);
  }

  .media-list :global(.media-list__link)::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  @media (max-width: 768px) {
    .media-list__item {
      grid-template-columns: calc(var(--thumb-width) * 0.55) minmax(0, 1fr);
      grid-template-rows: auto;
      align-content: start;
      column-gap: var(--space-sm);
      padding-block: var(--space-sm);
    }

    .media-list :global(.media-list__thumb) {
      grid-row: 1 / span 5;
      align-self: start;
      width: 100%;
    }

    .media-list :global(.media-list__main > :first-child),
    .media-list :global(.media-list__description),
    .media-list :global(.media-list__tech) {
      grid-row: auto;
    }

    .media-list :global(.media-list__aside > :is(:first-child, :nth-child(2))) {
      grid-column: 2;
      grid-row: auto;
      justify-self: start;
    }
  }
</style>

---
import type { Locale } from '@lib/i18n/languages';

import Flex from '@atoms/Flex/Flex.astro';
import type { IconName } from '@atoms/Icon/iconNames';
import EntryHeader from '@organisms/EntryHeader/EntryHeader.astro';
import EntrySection, { type EntrySectionData } from '@organisms/EntrySection/EntrySection.astro';

export interface EntryData {
  id: string;
  name: string;
  logo?: string;
  icon?: IconName;
  url?: string;
  start?: string;
  end?: string;
  title: string;
  titleNote?: string;
  sections?: readonly EntrySectionData[];
}

interface Props {
  entry: EntryData;
  locale: Locale;
  stackLabel?: string;
  projectLinkLabel?: string;
}

const { entry, locale, stackLabel = '', projectLinkLabel = '' } = Astro.props;
---

<Flex as='article' id={entry.id} gap='xs' class='entry'>
  <EntryHeader
    name={entry.name}
    logo={entry.logo}
    icon={entry.icon}
    url={entry.url}
    role={entry.title}
    roleNote={entry.titleNote}
    start={entry.start}
    end={entry.end}
    locale={locale}
  />

  {entry.sections && (
    <div class='entry__sections'>
      {entry.sections.map((section, index) => (
        <EntrySection
          id={`${entry.id}-section-${index + 1}`}
          section={section}
          locale={locale}
          stackLabel={stackLabel}
          projectLinkLabel={projectLinkLabel}
        />
      ))}
    </div>
  )}
</Flex>

<style>
  .entry {
    scroll-margin-top: var(--space-md);
  }

  .entry__sections {
    margin-top: var(--space-xs);
    padding-inline-start: calc(var(--logo-size) + var(--space-md));
  }

  @media (max-width: 768px) {
    .entry__sections {
      padding-inline-start: 0;
    }
  }
</style>

---
import { getDictionary } from '@lib/i18n/getDictionary';
import type { Locale } from '@lib/i18n/languages';

import LanguageSwitcher from '@molecules/LanguageSwitcher/LanguageSwitcher.astro';
import PreferenceToggle from '@molecules/PreferenceToggle/PreferenceToggle.astro';
import SettingsRow from '@molecules/SettingsRow/SettingsRow.astro';

interface Props {
  locale: Locale;
  id: string;
  class?: string;
  [key: string]: unknown;
}

const { locale, id, class: className, ...rest } = Astro.props;

const { settings, theme, motion } = getDictionary(locale);
const languageLabelId = `${id}-language`;
---

<div id={id} role='group' aria-label={settings.label} class:list={['settings-list', className]} {...rest}>
  <SettingsRow label={settings.language} labelId={languageLabelId}>
    <LanguageSwitcher locale={locale} aria-describedby={languageLabelId} />
  </SettingsRow>

  <SettingsRow label={settings.themeVisible} hiddenLabel>
    <PreferenceToggle variant='theme' label={settings.theme} titleOn={theme.toDark} titleOff={theme.toLight} />
  </SettingsRow>

  <SettingsRow label={settings.motion} hiddenLabel>
    <PreferenceToggle variant='motion' label={settings.motion} titleOn={motion.resume} titleOff={motion.stop} />
  </SettingsRow>
</div>

<style>
  .settings-list {
    display: grid;
    gap: var(--space-xs);
  }

  .settings-list[hidden] {
    display: none;
  }
</style>

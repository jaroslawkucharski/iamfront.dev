---
import { getDictionary } from '@lib/i18n/getDictionary';
import type { Locale } from '@lib/i18n/languages';
import type { BadgeItem } from '@typings/badge';
import type { Project } from '@typings/content';

import DescriptionList from '@atoms/DescriptionList/DescriptionList.astro';
import Text from '@atoms/Text/Text.astro';
import AsideBlock from '@molecules/AsideBlock/AsideBlock.astro';
import BadgeList from '@molecules/BadgeList/BadgeList.astro';
import DateRange from '@molecules/DateRange/DateRange.astro';
import DescriptionItem from '@molecules/DescriptionItem/DescriptionItem.astro';
import ExternalLinkList from '@molecules/ExternalLinkList/ExternalLinkList.astro';

interface Props {
  project: Project;
  stack: BadgeItem[];
  locale: Locale;
}

const { project, stack, locale } = Astro.props;

const { projects, externalLink } = getDictionary(locale);
const newTab = ` ${externalLink.newTab}`;

const typeText = [
  ...project.types.map((type) => projects.types[type]),
  ...(project.archived ? [projects.archived] : []),
].join(', ');

const links = [
  ...(project.links.live ? [{ href: project.links.live, label: projects.live }] : []),
  ...(project.links.repo ? [{ href: project.links.repo, label: projects.repo }] : []),
];
---

<AsideBlock title={projects.details}>
  <DescriptionList stacked>
    {project.start && (
      <DescriptionItem term={projects.period}>
        <DateRange start={project.start} end={project.end} locale={locale} />
      </DescriptionItem>
    )}

    {project.company && (
      <DescriptionItem term={projects.company}>
        <Text size='sm' color='default'>
          {project.company}
        </Text>
      </DescriptionItem>
    )}

    <DescriptionItem term={projects.type}>
      <Text size='sm' color='default'>
        {typeText}
      </Text>
    </DescriptionItem>
  </DescriptionList>
</AsideBlock>

<AsideBlock title={projects.stack}>
  <BadgeList label={projects.stack} items={stack} />
</AsideBlock>

{links.length > 0 && <ExternalLinkList label={projects.links} links={links} newTabLabel={newTab} />}

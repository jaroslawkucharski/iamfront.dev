---
interface Props {
  asideLabel: string;
  class?: string;
}

const { asideLabel, class: className } = Astro.props;
---

<div class:list={['article-layout', className]}>
  <div class='article-layout__main'>
    <slot />
  </div>

  <aside class='article-layout__aside' aria-label={asideLabel}>
    <div class='article-layout__sticky'>
      <slot name='aside' />
    </div>
  </aside>
</div>

<style>
  .article-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--aside-width);
    align-items: start;
    gap: var(--space-xl);
  }

  .article-layout__main {
    display: grid;
    gap: var(--space-lg);
    min-width: 0;
  }

  .article-layout__sticky {
    position: sticky;
    top: var(--space-md);
    display: grid;
    gap: var(--space-md);
  }

  @media (max-width: 1024px) {
    .article-layout {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-lg);
    }

    .article-layout__aside {
      order: -1;
    }

    .article-layout__sticky {
      position: static;
    }
  }
</style>

---
import { getDictionary } from '@lib/i18n/getDictionary';
import { interpolate } from '@lib/i18n/interpolate';
import type { Locale } from '@lib/i18n/languages';
import type { ImageData } from '@typings/content';

import type { IconName } from '@atoms/Icon/iconNames';
import Link from '@atoms/Link/Link.astro';
import Text from '@atoms/Text/Text.astro';
import DateRange from '@molecules/DateRange/DateRange.astro';
import EntryLogo from '@molecules/EntryLogo/EntryLogo.astro';

interface Props {
  name: string;
  logo?: ImageData;
  icon?: IconName;
  url?: string;
  role?: string;
  roleNote?: string;
  start?: string;
  end?: string;
  locale: Locale;
}

const { name, logo, icon, url, role, roleNote, start, end, locale } = Astro.props;

const hasLogo = Boolean(logo || icon);

const { externalLink } = getDictionary(locale);
const newTab = ` ${externalLink.newTab}`;
const linkTitle = `${interpolate(externalLink.title, { name })}${newTab}`;
---

<div class:list={['entry-header', { 'entry-header--logo': hasLogo }]}>
  <EntryLogo name={name} logo={logo} icon={icon} locale={locale} class='entry-header__logo' />

  <Text as='h3' size='lg' weight='medium' color='default' tracking='label' class='entry-header__name'>
    {url ? (
      <Link
        href={url}
        external
        newTabLabel={newTab}
        title={linkTitle}
        size='lg'
        weight='medium'
        color='default'
        tracking='label'
        wrap
      >
        {name}
      </Link>
    ) : (
      name
    )}
  </Text>

  {role && (
    <Text size='sm' color='default' class='entry-header__role'>
      <Fragment set:html={role} />

      {roleNote && <Text as='span' size='sm' color='muted'>{` (${roleNote})`}</Text>}
    </Text>
  )}

  {start && <DateRange start={start} end={end} locale={locale} class='entry-header__date' />}
</div>

<style>
  .entry-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-3xs) var(--space-md);
    align-items: center;
  }

  .entry-header--logo {
    grid-template-columns: auto minmax(0, 1fr) auto;
  }

  .entry-header :global(.entry-header__logo) {
    grid-row: span 2;
    align-self: center;
  }

  .entry-header :global(.entry-header__name) {
    margin: 0;
  }

  .entry-header > :global(*) {
    grid-column: 1;
  }

  .entry-header--logo > :global(*) {
    grid-column: 2;
  }

  .entry-header--logo > :global(.entry-header__logo) {
    grid-column: 1;
  }

  .entry-header :global(.entry-header__date) {
    grid-column: 2;
    grid-row: 1;
    align-self: center;
    white-space: nowrap;
  }

  .entry-header--logo :global(.entry-header__date) {
    grid-column: 3;
  }

  @media (max-width: 768px) {
    .entry-header {
      grid-template-columns: minmax(0, 1fr);
    }

    .entry-header--logo {
      grid-template-columns: auto minmax(0, 1fr);
      column-gap: var(--space-sm);
    }

    .entry-header :global(.entry-header__date) {
      grid-column: 1;
      grid-row: auto;
      white-space: normal;
    }

    .entry-header--logo :global(.entry-header__date) {
      grid-column: 2;
    }

    .entry-header :global(.entry-header__logo) {
      grid-row: span 3;
    }
  }
</style>

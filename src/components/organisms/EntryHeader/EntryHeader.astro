---
import type { ImageMetadata } from 'astro';

import { getLogo } from '@helpers/getLogo';
import { getDictionary } from '@lib/i18n/getDictionary';
import type { Locale } from '@lib/i18n/languages';

import Icon, { type IconName } from '@atoms/Icon/Icon.astro';
import Link from '@atoms/Link/Link.astro';
import Picture from '@atoms/Picture/Picture.astro';
import Text from '@atoms/Text/Text.astro';
import DateRange from '@molecules/DateRange/DateRange.astro';
import RichText from '@molecules/RichText/RichText.astro';

type Levels = 2 | 3 | 4;

interface Props {
  name: string;
  logo?: string;
  image?: { src: ImageMetadata; alt: string };
  icon?: IconName;
  url?: string;
  urlText?: string;
  level?: Levels;
  role?: string;
  roleNote?: string;
  start?: string;
  end?: string;
  locale: Locale;
}

const { name, logo, image, icon, url, urlText, role, roleNote, level = 3, start, end, locale } = Astro.props;

const signet = getLogo(logo);
const dictionary = getDictionary(locale);
const logoAlt = dictionary.logoAlt.replace('{name}', name);

const linked = url && urlText && name.includes(urlText) ? urlText : name;
const [before, after] =
  linked === name ? ['', ''] : [name.slice(0, name.indexOf(linked)), name.slice(name.indexOf(linked) + linked.length)];
const linkTitle = `${dictionary.externalLink.title.replace('{name}', linked)} ${dictionary.externalLink.newTab}`;
---

<div class:list={['entry-header', { 'entry-header--logo': signet || image || icon }]}>
  {signet && (
    <Picture
      src={signet}
      alt={logoAlt}
      size={64}
      sizeMobile={48}
      shape='square'
      fit='contain'
      class='entry-header__logo'
    />
  )}

  {!signet && image && (
    <Picture
      src={image.src}
      alt={image.alt}
      size={64}
      sizeMobile={48}
      shape='square'
      class='entry-header__logo entry-header__logo--photo'
    />
  )}

  {!signet && !image && icon && (
    <span class='entry-header__logo entry-header__logo--icon' aria-hidden='true'>
      <Icon name={icon} size={28} />
    </span>
  )}

  <Text as={`h${level}`} size='lg' weight='medium' color='default' tracking='label' class='entry-header__name'>
    {url ? (
      <>
        {before}

        <Link
          href={url}
          external
          newTabLabel={` ${dictionary.externalLink.newTab}`}
          title={linkTitle}
          size='lg'
          weight='medium'
          color='default'
          tracking='label'
          wrap
        >
          {linked}
        </Link>

        {after}
      </>
    ) : (
      name
    )}
  </Text>

  {role && (
    <Text size='sm' color='default' class='entry-header__role'>
      <RichText as='span' size='sm' color='default' text={role} newTabLabel={` ${dictionary.externalLink.newTab}`} />

      {roleNote && <Text as='span' size='sm' color='muted'>{` (${roleNote})`}</Text>}
    </Text>
  )}

  {start && <DateRange start={start} end={end} locale={locale} class='entry-header__date' />}
</div>

<style>
  .entry-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-3xs) var(--space-md);
    align-items: center;
  }

  .entry-header--logo {
    grid-template-columns: auto minmax(0, 1fr) auto;
  }

  .entry-header :global(.entry-header__logo) {
    grid-row: span 2;
    align-self: center;
  }

  .entry-header :global(.entry-header__logo--photo) {
    border-radius: var(--radius-sm);
  }

  .entry-header__logo--icon {
    width: var(--logo-size);
    height: var(--logo-size);
    display: grid;
    place-items: center;
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: var(--color-text-muted);
  }

  .entry-header :global(.entry-header__name) {
    margin: 0;
  }

  .entry-header > :global(*) {
    grid-column: 1;
  }

  .entry-header--logo > :global(*) {
    grid-column: 2;
  }

  .entry-header--logo > :global(.entry-header__logo) {
    grid-column: 1;
  }

  .entry-header :global(.entry-header__date) {
    grid-column: 2;
    grid-row: 1;
    align-self: center;
    white-space: nowrap;
  }

  .entry-header--logo :global(.entry-header__date) {
    grid-column: 3;
  }

  @media (max-width: 768px) {
    .entry-header {
      grid-template-columns: minmax(0, 1fr);
    }

    .entry-header--logo {
      grid-template-columns: auto minmax(0, 1fr);
      column-gap: var(--space-sm);
    }

    .entry-header :global(.entry-header__date) {
      grid-column: 1;
      grid-row: auto;
      white-space: normal;
    }

    .entry-header--logo :global(.entry-header__date) {
      grid-column: 2;
    }

    .entry-header :global(.entry-header__logo) {
      grid-row: span 3;
    }

    .entry-header__logo--icon {
      width: calc(var(--logo-size) * 0.75);
      height: calc(var(--logo-size) * 0.75);
    }
  }
</style>

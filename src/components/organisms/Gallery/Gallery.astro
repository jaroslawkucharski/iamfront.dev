---
import type { ImageMetadata } from 'astro';

import Screenshot from '@molecules/Screenshot/Screenshot.astro';

interface Props {
  images: { src: ImageMetadata; dark?: ImageMetadata; alt: string }[];
  zoom: { group: string; label: string };
  class?: string;
}

const { images, zoom, class: className } = Astro.props;
---

<ul class:list={['gallery', className]}>
  {images.map((image) => (
    <li>
      <Screenshot
        src={image.src}
        dark={image.dark}
        alt={image.alt}
        sizes='(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 380px'
        ratio={16 / 10}
        zoom={zoom}
      />
    </li>
  ))}
</ul>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-sm);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 1024px) {
    .gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 768px) {
    .gallery {
      grid-template-columns: 1fr;
    }
  }
</style>

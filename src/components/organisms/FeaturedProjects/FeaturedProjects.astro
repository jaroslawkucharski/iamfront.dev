---
import { getRelativeLocaleUrl } from 'astro:i18n';

import { getDictionary } from '@lib/i18n/getDictionary';
import type { Locale } from '@lib/i18n/languages';
import type { Project } from '@typings/content';

import ArrowLink from '@molecules/ArrowLink/ArrowLink.astro';
import Section from '@molecules/Section/Section.astro';
import ProjectList from '@organisms/ProjectList/ProjectList.astro';

interface Props {
  projects: Project[];
  total: number;
  locale: Locale;
}

const { projects, total, locale } = Astro.props;

const dictionary = getDictionary(locale).projects;
const allLabel = `${dictionary.all} (${total})`;
---

<Section id='projects' title={dictionary.featuredHeading}>
  <ProjectList
    projects={projects}
    locale={locale}
    label={dictionary.featuredHeading}
    labelsLabel={dictionary.labelsLabel}
    techLabel={dictionary.stack}
  />

  <ArrowLink href={getRelativeLocaleUrl(locale, 'projects/')} title={allLabel}>
    {allLabel}
  </ArrowLink>
</Section>

---
import { getRelativeLocaleUrl } from 'astro:i18n';

import { person } from '@config/site';
import { getDictionary } from '@lib/i18n/getDictionary';
import { interpolate } from '@lib/i18n/interpolate';
import type { Locale } from '@lib/i18n/languages';
import type { ProjectImage, TimelineEntry } from '@typings/content';

import Flex from '@atoms/Flex/Flex.astro';
import Heading from '@atoms/Heading/Heading.astro';
import MediaBlock from '@atoms/MediaBlock/MediaBlock.astro';
import Picture from '@atoms/Picture/Picture.astro';
import BadgeList from '@molecules/BadgeList/BadgeList.astro';
import LinkList from '@molecules/LinkList/LinkList.astro';
import LabeledBadgeList from '@organisms/LabeledBadgeList/LabeledBadgeList.astro';

interface Props {
  highlights: string[];
  companies: TimelineEntry[];
  photo: ProjectImage;
  locale: Locale;
}

const { highlights, companies, photo, locale } = Astro.props;

const { hero } = getDictionary(locale);

const companyBadges = companies.map((company) => {
  const name = company.shortName ?? company.name;

  return {
    label: name,
    href: `${getRelativeLocaleUrl(locale, 'about/')}#${company.id}`,
    title: interpolate(hero.companyTitle, { name }),
    muted: true,
  };
});

const links = [
  { href: getRelativeLocaleUrl(locale, 'projects/'), ...hero.links.projects },
  { href: `${getRelativeLocaleUrl(locale)}#contact`, ...hero.links.contact },
];
---

<section class='hero' aria-labelledby='hero-title'>
  <MediaBlock mediaPosition='end' equal fill>
    <Flex gap='md' align='start'>
      <Heading level={1} variant='hero' id='hero-title'>
        <span class='hero__line'>{person.name}</span>

        <span class='hero__line'>{person.jobTitle}</span>
      </Heading>

      <Flex gap='2xs' align='start'>
        <BadgeList label={hero.highlightsLabel} items={highlights} variant='text' />

        <LabeledBadgeList label={hero.companiesLabel} items={companyBadges} underline />
      </Flex>

      <LinkList links={links} />
    </Flex>

    <Picture src={photo.src} dark={photo.dark} alt={photo.alt} size={600} priority slot='media' />
  </MediaBlock>
</section>

<style>
  .hero__line {
    display: block;
  }

  .hero :global(#hero-title) {
    font-size: min(var(--fs-hero), calc(100cqi / 14.2));
  }

  @media (min-width: 769px) {
    .hero :global(.media-block.media-block--equal) {
      grid-template-columns: minmax(0, 9fr) minmax(0, 10fr);
    }
  }

  .hero :global(.media-block__content) {
    container-type: inline-size;
    padding-block: var(--space-lg);
  }

  @media (max-width: 768px) {
    .hero :global(.media-block__content) {
      padding-block: 0;
    }

    .hero :global(.media-block__media) {
      margin-inline: calc(var(--page-gutter) * -1);
    }
  }
</style>

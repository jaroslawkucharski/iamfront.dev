---
import { getDictionary } from '@lib/i18n/getDictionary';
import type { Locale } from '@lib/i18n/languages';
import type { ProjectImage } from '@typings/content';

import Flex from '@atoms/Flex/Flex.astro';
import MediaBlock from '@atoms/MediaBlock/MediaBlock.astro';
import Picture from '@atoms/Picture/Picture.astro';
import Text from '@atoms/Text/Text.astro';
import Section from '@molecules/Section/Section.astro';

interface Props {
  bio: string[];
  photo: ProjectImage;
  locale: Locale;
}

const { bio, photo, locale } = Astro.props;

const { about } = getDictionary(locale);
---

<Section id='about' title={about.intro.heading} level={1}>
  <MediaBlock>
    <Flex gap='sm'>
      {bio.map((paragraph) => (
        <Text>
          <Fragment set:html={paragraph} />
        </Text>
      ))}
    </Flex>

    <Picture
      src={photo.src}
      dark={photo.dark}
      alt={photo.alt}
      shape='circle'
      size={280}
      sizeMobile={200}
      priority
      slot='media'
    />
  </MediaBlock>
</Section>

---
import type { ImageMetadata } from 'astro';

import { getLogo } from '@helpers/getLogo';
import { getDictionary } from '@lib/i18n/getDictionary';
import type { Locale } from '@lib/i18n/languages';

import Icon, { type IconName } from '@atoms/Icon/Icon.astro';
import Picture from '@atoms/Picture/Picture.astro';

interface Props {
  name: string;
  logo?: string;
  image?: { src: ImageMetadata; alt: string };
  icon?: IconName;
  locale: Locale;
  class?: string;
}

const { name, logo, image, icon, locale, class: className } = Astro.props;

const signet = getLogo(logo);
const logoAlt = getDictionary(locale).logoAlt.replace('{name}', name);
---

{signet && (
  <Picture
    src={signet}
    alt={logoAlt}
    size={64}
    sizeMobile={48}
    shape='square'
    fit='contain'
    class:list={['entry-logo', className]}
  />
)}

{!signet && image && (
  <Picture
    src={image.src}
    alt={image.alt}
    size={64}
    sizeMobile={48}
    shape='square'
    class:list={['entry-logo', 'entry-logo--photo', className]}
  />
)}

{!signet && !image && icon && (
  <span class:list={['entry-logo', 'entry-logo--icon', className]} aria-hidden='true'>
    <Icon name={icon} size={28} />
  </span>
)}

<style>
  :global(.entry-logo--photo) {
    border-radius: var(--radius-sm);
  }

  .entry-logo--icon {
    width: var(--logo-size);
    height: var(--logo-size);
    display: grid;
    place-items: center;
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .entry-logo--icon {
      width: calc(var(--logo-size) * 0.75);
      height: calc(var(--logo-size) * 0.75);
    }
  }
</style>

---
import { getLogo } from '@helpers/timeline/getLogo';
import { getDictionary } from '@lib/i18n/getDictionary';
import { interpolate } from '@lib/i18n/interpolate';
import type { Locale } from '@lib/i18n/languages';

import Icon from '@atoms/Icon/Icon.astro';
import type { IconName } from '@atoms/Icon/iconNames';
import Picture from '@atoms/Picture/Picture.astro';

interface Props {
  name: string;
  logo?: string;
  icon?: IconName;
  locale: Locale;
  class?: string;
}

const { name, logo, icon, locale, class: className } = Astro.props;

const signet = getLogo(logo);
const logoAlt = interpolate(getDictionary(locale).logoAlt, { name });
---

{signet && (
  <Picture
    src={signet.src}
    dark={signet.dark}
    alt={logoAlt}
    size={64}
    sizeMobile={48}
    shape='square'
    fit='contain'
    class:list={['entry-logo', className]}
  />
)}

{!signet && icon && (
  <span class:list={['entry-logo', 'entry-logo--icon', className]} aria-hidden='true'>
    <Icon name={icon} size={28} />
  </span>
)}

<style>
  .entry-logo--icon {
    width: var(--logo-size);
    height: var(--logo-size);
    display: grid;
    place-items: center;
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .entry-logo--icon {
      width: calc(var(--logo-size) * 0.75);
      height: calc(var(--logo-size) * 0.75);
    }
  }
</style>

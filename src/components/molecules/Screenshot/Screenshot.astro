---
import { getImage } from 'astro:assets';

import { getImageProps } from '@helpers/images/getImageProps';
import type { ImageSource } from '@typings/content';

import Picture from '@atoms/Picture/Picture.astro';
import VisuallyHidden from '@atoms/VisuallyHidden/VisuallyHidden.astro';

type Zoom = { group: string; label: string };

interface Props {
  src: ImageSource;
  dark?: ImageSource;
  alt: string;
  sizes: string;
  priority?: boolean;
  ratio?: number;
  zoom?: Zoom;
  class?: string;
}

const { src, dark, alt, sizes, priority = false, ratio, zoom, class: className } = Astro.props;

const toLarge = (image: ImageSource) => {
  const width = Math.min(image.width, 1920);

  return getImage({
    ...getImageProps(image),
    width,
    height: Math.round((image.height * width) / image.width),
    format: 'webp',
  });
};

const large = zoom ? await toLarge(src) : undefined;
const largeDark = zoom && dark ? await toLarge(dark) : undefined;

const style = ratio ? `aspect-ratio: ${ratio}` : undefined;
---

{large && zoom ? (
  <a
    href={large.src}
    class='screenshot-link'
    data-lightbox={zoom.group}
    data-lightbox-dark={largeDark?.src}
    data-caption={alt}
    title={zoom.label}
  >
    <Picture
      src={src}
      dark={dark}
      alt={alt}
      widths={[600, 1200]}
      sizes={sizes}
      priority={priority}
      class:list={['screenshot', { 'screenshot--cropped': ratio }, className]}
      style={style}
    />

    <VisuallyHidden>{` – ${zoom.label}`}</VisuallyHidden>
  </a>
) : (
  <Picture
    src={src}
    dark={dark}
    alt={alt}
    widths={[600, 1200]}
    sizes={sizes}
    priority={priority}
    class:list={['screenshot', { 'screenshot--cropped': ratio }, className]}
    style={style}
  />
)}

<style>
  .screenshot {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-sm);
    background: var(--color-surface);
  }

  .screenshot--cropped {
    object-fit: cover;
    object-position: top center;
    border: var(--border-width) solid var(--color-border-subtle);
  }

  .screenshot-link {
    display: block;
    border-radius: var(--radius-sm);
    cursor: var(--cursor-zoom-in);
  }

  .screenshot-link .screenshot {
    transition: opacity var(--duration-fast) var(--ease-standard);
  }

  .screenshot-link:hover .screenshot {
    opacity: var(--opacity-pressed);
  }
</style>

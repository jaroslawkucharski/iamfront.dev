---
import Text from '@atoms/Text/Text.astro';

interface Props {
  term: string;
}

const { term } = Astro.props;
---

<div class='description-item'>
  <Text as='dt' size='md' weight='medium' color='default' tracking='label'>
    {term}
  </Text>

  <dd class='description-item__content'>
    <slot />
  </dd>
</div>

<style>
  .description-item {
    display: grid;
    grid-template-columns: var(--description-columns, var(--label-column) 1fr);
    align-items: baseline;
    gap: var(--space-2xs) var(--space-sm);
  }

  .description-item__content {
    margin: 0;
  }

  @media (max-width: 768px) {
    .description-item {
      grid-template-columns: 1fr;
    }
  }
</style>

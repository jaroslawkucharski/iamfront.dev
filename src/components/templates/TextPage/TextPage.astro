---
import { getDictionary } from '@lib/i18n/getDictionary';
import type { Locale } from '@lib/i18n/languages';

import Text from '@atoms/Text/Text.astro';
import Section from '@molecules/Section/Section.astro';
import TextSection, { type TextSectionData } from '@organisms/TextSection/TextSection.astro';
import MainTemplate from '@templates/MainTemplate/MainTemplate.astro';

export interface TextPageContent {
  title: string;
  description: string;
  intro: string;
  updated: string;
  sections: readonly TextSectionData[];
}

interface Props {
  id: string;
  locale: Locale;
  content: TextPageContent;
}

const { id, locale, content } = Astro.props;

const { textPage } = getDictionary(locale);

const updated = new Intl.DateTimeFormat(locale, {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
}).format(new Date(`${content.updated}T00:00:00Z`));
---

<MainTemplate locale={locale} title={content.title} description={content.description} contactCta={false}>
  <Section id={id} title={content.title} level={1} gap='lg'>
    <Text size='lg' color='default' class='text-page__text'>
      {content.intro}
    </Text>

    {content.sections.map((section) => (
      <TextSection section={section} locale={locale} />
    ))}

    <Text size='sm' color='muted'>
      {`${textPage.updated} `}

      <time datetime={content.updated}>{updated}</time>
    </Text>
  </Section>
</MainTemplate>

<style>
  .text-page__text {
    max-width: var(--text-width);
  }
</style>

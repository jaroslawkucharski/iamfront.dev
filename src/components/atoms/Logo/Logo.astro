---
interface Props {
  label?: string;
  href?: string;
  class?: string;
  [key: string]: unknown;
}

const { label = 'iamfront.dev', href, class: className, ...rest } = Astro.props;

const Wrapper = href ? 'a' : Fragment;
const linkProps = href
  ? { href, 'aria-label': label, title: label, class: ['logo-link', className].filter(Boolean).join(' '), ...rest }
  : {};

const svgProps = href ? {} : rest;
const svgLabel = href ? '' : label;

const gradientId = 'logo-gradient';

<style>
  .logo-link {
    display: inline-flex;
  }

  .logo {
    width: auto;
    height: var(--brand-logo-height);
    aspect-ratio: 146 / 20;
    color: var(--color-logo);
  }

  .logo__cursor {
    animation: logo-blink 1s steps(1, end) infinite;
  }

  :global(:root[data-motion='off']) .logo__cursor {
    animation: none;
  }

  @keyframes logo-blink {
    50% {
      opacity: 0;
    }
  }

  .logo__stop-1 {
    stop-color: var(--color-accent-blue);
  }

  .logo__stop-2 {
    stop-color: var(--color-accent-purple);
  }
</style>

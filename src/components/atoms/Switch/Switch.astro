---
interface Props {
  label: string;
  checked?: boolean;
  href?: string;
  class?: string;
  [key: string]: unknown;
}

const { label, checked = false, href, class: className, ...rest } = Astro.props;

const Tag = href ? 'a' : 'button';
const state = checked ? 'true' : 'false';
const attrs = href
  ? { href, 'data-checked': state }
  : ({ type: 'button', role: 'switch', 'aria-checked': state, 'aria-label': label } as const);
---

<Tag title={label} class:list={['switch', className]} {...attrs} {...rest}>
  <span class='switch__track' aria-hidden='true'>
    <span class='switch__icon switch__icon--on'>
      <slot name='on' />
    </span>

    <span class='switch__icon switch__icon--off'>
      <slot name='off' />
    </span>

    <span class='switch__knob'>
      <span class='switch__icon switch__icon--on'>
        <slot name='knob-on' />
      </span>

      <span class='switch__icon switch__icon--off'>
        <slot name='knob-off' />
      </span>
    </span>
  </span>

  {href && <span class='visually-hidden'>{label}</span>}
</Tag>

<style>
  .switch {
    --knob-size: calc(var(--switch-height) - 2 * var(--switch-padding));
    --knob-x: 0px;

    display: inline-grid;
    place-items: center;
    min-width: var(--tap-target);
    min-height: var(--tap-target);
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: var(--radius-full);
    background: transparent;
    color: inherit;
    text-decoration: none;
    cursor: var(--cursor-pointer);
  }

  .switch:is([aria-checked='true'], [data-checked='true']) {
    --knob-x: calc(var(--switch-width) - var(--knob-size) - 2 * var(--switch-padding));
  }

  .switch__track {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: var(--switch-width);
    height: var(--switch-height);
    padding-inline: calc(var(--switch-padding) * 2);
    border-radius: var(--radius-full);
    background: var(--color-text-muted);
    color: var(--color-bg);
    font-size: calc(var(--fs-xs) * 0.85);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-label);
    line-height: 1;
    transition: background-color var(--duration-fast) var(--ease-standard);
  }

  .switch:hover .switch__track {
    background: var(--color-text);
  }

  .switch__icon {
    display: inline-flex;
    transition: opacity var(--duration-fast) var(--ease-standard);
  }

  .switch:is([aria-checked='false'], [data-checked='false']) .switch__icon--on,
  .switch:is([aria-checked='true'], [data-checked='true']) .switch__icon--off {
    opacity: 0;
  }

  .switch__knob {
    position: absolute;
    display: grid;
    place-items: center;
    color: var(--color-text);
    top: var(--switch-padding);
    left: var(--switch-padding);
    width: var(--knob-size);
    height: var(--knob-size);
    border-radius: var(--radius-full);
    background: var(--color-bg);
    transform: translateX(var(--knob-x));
    transition: transform var(--duration-fast) var(--ease-standard);
  }

  .switch__knob > .switch__icon {
    grid-area: 1 / 1;
  }

  .switch:active .switch__knob {
    transform: translateX(var(--knob-x)) scale(0.9);
  }
</style>

---
type Variants = 'default' | 'search';

interface Props {
  variant?: Variants;
  multiline?: boolean;
  rows?: number;
  class?: string;
  [key: string]: unknown;
}

const { variant = 'default', multiline = false, rows = 6, class: className, ...rest } = Astro.props;

const classes = ['input', `input--${variant}`, className];
---

{multiline ? (
  <textarea class:list={[classes, 'input--multiline']} rows={rows} {...rest} />
) : (
  <input class:list={classes} {...rest} />
)}

<style>
  .input {
    width: 100%;
    min-height: var(--tap-target);
    padding: var(--space-xs) var(--space-sm);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--color-text);
    font: inherit;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    letter-spacing: var(--ls-body);
    transition: border-color var(--duration-fast) var(--ease-standard);
  }

  .input--multiline {
    resize: vertical;
  }

  .input:hover {
    border-color: var(--color-text);
  }

  .input[aria-invalid='true'] {
    border-color: var(--color-error);
    border-width: var(--border-width-strong);
  }

  /* Search */
  .input--search {
    min-height: var(--control-sm);
    padding: 0 var(--space-sm) 0 calc(var(--space-xs) + var(--icon-sm) + var(--space-xs));
    border-color: var(--color-border-subtle);
    border-radius: var(--radius-full);
    font-size: var(--fs-sm);
    line-height: normal;
    letter-spacing: var(--ls-label);
  }

  .input--search::placeholder {
    color: var(--color-text-muted);
    opacity: 1;
  }

  .input--search:hover,
  .input--search:focus {
    border-color: var(--color-border);
  }
</style>

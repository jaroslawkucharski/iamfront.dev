---
import type { TypographyProps } from '@/types/typography';

type Elements = 'a' | 'button';

interface Props extends TypographyProps {
  as?: Elements;
  href?: string;
  active?: boolean;
  external?: boolean;
  keepReferrer?: boolean;
  newTabLabel?: string;
  wrap?: boolean;
  inline?: boolean;
  class?: string;
  [key: string]: unknown;
}

const {
  as: Tag = 'a',
  href,
  active = false,
  external = false,
  keepReferrer = false,
  newTabLabel,
  wrap = false,
  inline = false,
  size = 'md',
  weight = 'semibold',
  color = 'muted',
  tracking = 'wide',
  uppercase = false,
  class: className,
  ...rest
} = Astro.props;

const externalAttrs = external ? { target: '_blank', rel: keepReferrer ? 'noopener' : 'noopener noreferrer' } : {};
---

<Tag
  href={Tag === 'a' ? href : undefined}
  type={Tag === 'button' ? 'button' : undefined}
  aria-current={active ? 'page' : undefined}
  class:list={[
    'text',
    `text--size-${size}`,
    `text--weight-${weight}`,
    `text--color-${color}`,
    `text--tracking-${tracking}`,
    { 'text--uppercase': uppercase },
    'link',
    { 'link--active': active, 'link--wrap': wrap, 'link--inline': inline },
    className,
  ]}
  {...externalAttrs}
  {...rest}
>
  <slot />

  {external && newTabLabel && <span class='visually-hidden'>{newTabLabel}</span>}
</Tag>

<style>
  .link:is(button) {
    padding: 0;
    border: 0;
    background-color: transparent;
    color: inherit;
    font-family: inherit;
    line-height: inherit;
    cursor: var(--cursor-pointer);
  }

  .link {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: var(--space-xs);
    white-space: nowrap;
    background-image: linear-gradient(currentColor, currentColor);
    background-position: 0 100%;
    background-repeat: no-repeat;
    background-size: 0% var(--border-width);
    transition:
      color var(--duration-fast) var(--ease-standard),
      background-size var(--duration-fast) var(--ease-standard),
      opacity var(--duration-fast) var(--ease-standard);
  }

  .link:hover,
  .link:focus-visible {
    color: var(--color-text);
    background-size: 100% var(--border-width);
  }

  .link :global(.icon) {
    transition: translate var(--duration-fast) var(--ease-standard);
  }

  .link:is(:hover, :focus-visible) :global([data-icon='arrow-right']) {
    translate: calc(var(--motion-distance) / 2) 0;
  }

  .link:is(:hover, :focus-visible) :global([data-icon='arrow-left']) {
    translate: calc(var(--motion-distance) / -2) 0;
  }

  .link:is(:hover, :focus-visible) :global([data-icon='external']) {
    translate: calc(var(--motion-distance) / 3) calc(var(--motion-distance) / -3);
  }

  .link:is(:hover, :focus-visible) :global([data-icon='arrow-up']) {
    translate: 0 calc(var(--motion-distance) / -2);
  }

  .link:is(:hover, :focus-visible) :global([data-icon='download']) {
    translate: 0 calc(var(--motion-distance) / 3);
  }

  .link:active {
    opacity: var(--opacity-pressed);
  }

  .link--wrap {
    display: inline;
    white-space: normal;
  }

  .link--wrap > :global(svg) {
    display: inline-block;
    margin-inline-start: var(--space-2xs);
    vertical-align: middle;
  }

  .link--inline {
    display: inline;
    background-size: 100% var(--border-width);
  }

  .link--active {
    color: var(--color-text);
    background-size: 100% var(--border-width);
  }
</style>
